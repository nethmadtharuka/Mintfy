rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helper functions ----
    // True when the request comes from a signed-in user.
    function isSignedIn() {
      return request.auth != null;
    }

    // True when the signed-in user is the owner of this data (FR-A3, NFR-04).
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---- users/{userId} : one document per Mintfy user ----
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;   // account deletion is not in scope

      // Each private sub-collection: only the owner may read or write.
      match /incomeSources/{docId}     { allow read, write: if isOwner(userId); }
      match /incomeEntries/{docId}     { allow read, write: if isOwner(userId); }
      match /expenses/{docId}          { allow read, write: if isOwner(userId); }
      match /categories/{docId}        { allow read, write: if isOwner(userId); }
      match /paymentMethods/{docId}    { allow read, write: if isOwner(userId); }
      match /recurringExpenses/{docId} { allow read, write: if isOwner(userId); }
      match /goals/{docId}             { allow read, write: if isOwner(userId); }
    }

    // Anything not matched above is denied automatically.
  }
}
